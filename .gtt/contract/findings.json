      "plane": "definition",
      "owner": "agent",
      "level": "NOTICE",
      "text": {
        "en": "code has been changing for {minutes} min with no Story In Progress{probable}",
        "es": "el código lleva {minutes} min cambiando sin ninguna historia En curso{probable}"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "Mark the Story you are building as In Progress.",
          "es": "Marca como In Progress la historia que construyes."
        }
      }
    },
    "GTT-DEPENDS": {
      "plane": "code",
      "owner": "agent",
      "level": "WARNING",
      "text": {
        "en": "{frm} depends on {to}, which stack.md 5 does not allow ({count} import(s), e.g. {example})",
        "es": "{frm} depende de {to}, y stack.md 5 no lo permite ({count} importación(es), p. ej. {example})"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "Remove the dependency of {frm} on {to} ({example}), or propose the change of the rule in stack.md 5.",
          "es": "Quita la dependencia de {frm} sobre {to} ({example}), o propone el cambio de la regla en stack.md 5."
        }
      }
    },
    "CODE-EMPTY": {
      "plane": "code",
      "owner": null,
      "level": "NOTICE",
      "text": {
        "en": "{path} is declared in stack.md and has no code yet",
        "es": "{path} está declarado en stack.md y todavía no tiene código"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "",
          "es": ""
        }
      }
    }
  },
  "untriaged_days": 1,
  "owners_extra": [
    "gtt_activity"
  ],
  "code": {
