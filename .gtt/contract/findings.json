      "plane": "governance",
      "owner": "agent",
      "level": "WARNING",
      "text": {
        "en": "check `{check}` {state}",
        "es": "el chequeo `{check}` {state}"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "Fix the check `{check}`: {state}.",
          "es": "Corrige el chequeo `{check}`: {state}."
        }
      }
    },
    "GOV-DEC": {
      "plane": "governance",
      "owner": "human",
      "level": "WARNING",
      "text": {
        "en": "the agent decided: {what}",
        "es": "el agente decidió: {what}"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "the agent decided: {what}",
          "es": "el agente decidió: {what}"
        }
      }
    },
    "GOV-RUN": {
      "plane": "governance",
      "owner": "human",
      "level": "NOTICE",
      "text": {
        "en": "{run} is ready to run",
        "es": "{run} está listo para correr"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": "gtt run {n}",
        "chat": {
          "en": "{run} is ready to run",
          "es": "{run} está listo para correr"
        }
      }
    },
    "GTT-SHADOW-STATE": {
      "plane": "governance",
      "owner": "agent",
      "level": "NOTICE",
      "text": {
        "en": "parallel state outside gtt-domain/: {path}",
        "es": "estado paralelo fuera de gtt-domain/: {path}"
      },
      "fix": {
        "fields": [],
        "about": false,
        "command": null,
        "chat": {
          "en": "Migrate {path} into gtt-domain/ and archive the file.",
          "es": "Migra {path} a gtt-domain/ y archiva el archivo."
        }
      }
    },
    "DLV-FINDING": {
      "plane": "delivery",
      "owner": "agent",
      "level": "NOTICE",
      "text": {
        "en": "{what}",
        "es": "{what}"
      },
