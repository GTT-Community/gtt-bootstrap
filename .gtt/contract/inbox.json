{
  "schema": 1,
  "notice": "Inbox contract: the one pipeline every change enters. What a person writes is an IDEA-NNN (an idea, a change request or an architect's ADR draft); what the agent writes is a PROP-NNN. Each entry moves through the stages below and every step leaves one line under the final `---` of its own file: the state is the last line, never stored apart. The engine (.gtt/scripts/gtt_inbox.py) carries no transition of its own: it reads them here, and refuses any other with exit 1 and nothing written. Absorbs ideas.json, which stays one version as a read-only alias. Data only.",
  "entries": {
    "IDEA": {
      "dirs": [
        "docs/ideas",
        "gtt-domain/adr/drafts"
      ],
      "archive_dirs": [
        "gtt-domain/adr/drafts/done"
      ],
      "pattern": "IDEA-{number}"
    },
    "PROP": {
      "dirs": [
        "gtt-domain/proposals"
      ],
      "pattern": "PROP-{number}-{slug}",
      "archive": {
        "closed": "gtt-domain/proposals/done",
        "rejected": "gtt-domain/proposals/withdrawn"
      }
    }
  },
  "drafts_dir": "gtt-domain/proposals/drafts",
  "adr_template": "gtt-domain/adr/ADR-TEMPLATE.md",
  "types": [
    "idea",
    "solicitud",
    "adr"
  ],
  "levels": [
    "arch",
    "spec",
    "scope",
    "work"
  ],
  "route_levels": [
    "arch",
    "spec",
    "scope",
    "non-goal"
  ],
  "stages": [
    "new",
    "review",
    "accepted",
    "ratify",
    "work",
    "closed",
    "parked",
    "rejected"
  ],
  "priorities": [
    "urgent",
    "normal",
    "low"
  ],
  "request_fields": [
    "change",
    "reason",
    "trigger",
    "scope",
    "impact",
    "risk",
    "priority"
  ],
  "max_chars": 4000,
  "title_chars": 80,
  "actors": [
    "human",
    "agent",
    "gtt"
  ],
  "transitions": [
    {
      "id": "T1",
      "from": null,
      "to": "new",
      "op": [
        "inbox.add"
      ],
      "actor": "human",
      "entry": [
        "IDEA"
      ],
      "guard": "not empty, at most max_chars; a request carries change and reason",
      "line": null
    },
    {
      "id": "T2",
      "from": null,
      "to": "new",
      "op": [
        "adr.new",
        "adr.adopt"
      ],
      "actor": "human",
      "entry": [
        "IDEA"
      ],
      "guard": "unique title; adopt only an ADR written by hand after the freeze that did not come from a promotion",
      "line": null
    },
    {
      "id": "T3",
      "from": [
        "new"
      ],
      "to": "work",
      "op": [
        "inbox.triage"
      ],
      "variant": [
        "work"
      ],
      "actor": "agent",
      "entry": [
        "IDEA"
      ],
      "guard": "STORY-m exists and cites `Origin: IDEA-n`",
      "line": "triage"
    },
    {
      "id": "T4",
      "from": [
        "new"
      ],
      "to": "closed",
      "op": [
        "inbox.triage"
      ],
      "variant": [
        "covered"
      ],
      "actor": "agent",
      "entry": [
        "IDEA"
      ],
      "guard": "the reference exists; an informative DEC is opened",
      "line": "triage"
    },
    {
      "id": "T5",
      "from": [
        "new"
      ],
      "to": "review",
      "op": [
        "inbox.triage"
      ],
      "variant": [
        "spec",
        "arch",
        "scope",
        "non-goal"
      ],
      "actor": "agent",
      "entry": [
        "IDEA"
      ],
      "guard": "PROP-n is registered with `Origen: IDEA-n` and in review",
      "line": "triage"
    },
    {
      "id": "T6",
      "from": [
        "new"
      ],
      "to": "new",
      "op": [
        "inbox.triage"
      ],
      "variant": [
        "ask"
      ],
      "actor": "agent",
      "entry": [
        "IDEA"
      ],
      "guard": "the ASK exists",
      "line": "triage"
    },
    {
      "id": "T7",
      "from": [
        "new"
      ],
      "to": [
        "accepted",
        "review"
      ],
      "op": [
        "inbox.reconcile"
      ],
      "actor": "gtt",
      "entry": [
        "IDEA"
      ],
      "guard": "an ADR draft is complete: no markers, Context, Decision and Consequences filled",
      "line": "ready",
      "owner": "reconcile"
    },
    {
      "id": "T8",
      "from": [
        "new"
      ],
      "to": "closed",
      "op": [
        "inbox.triage"
      ],
      "variant": [
        "incorporated"
      ],
      "actor": "agent",
      "entry": [
        "IDEA"
      ],
      "guard": "the project is not frozen",
      "line": "triage"
    },
    {
      "id": "T9",
      "from": null,
      "to": "review",
      "op": [
        "inbox.propose"
      ],
      "actor": "agent",
      "entry": [
        "PROP"
      ],
      "guard": "complete form; valid level; a cited idea is in `new`",
      "line": "review"
    },
    {
      "id": "T10",
      "from": [
        "review"
      ],
      "to": "accepted",
      "op": [
        "pending.answer"
      ],
      "variant": [
        "accept",
        "accept-urgent",
        "accept-low"
      ],
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "the entry did not change since the REV was opened (sha256)",
      "line": "decision"
    },
    {
      "id": "T11",
      "from": [
        "review"
      ],
      "to": "parked",
      "op": [
        "pending.answer"
      ],
      "variant": [
        "park"
      ],
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "same as T10",
      "line": "decision"
    },
    {
      "id": "T12",
      "from": [
        "review"
      ],
      "to": "rejected",
      "op": [
        "pending.answer"
      ],
      "variant": [
        "reject"
      ],
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "same as T10; a rejected closure returns its idea to `new`",
      "line": "decision"
    },
    {
      "id": "T13",
      "from": [
        "review"
      ],
      "to": "closed",
      "op": [
        "inbox.supersede"
      ],
      "actor": "agent",
      "entry": [
        "PROP"
      ],
      "guard": "closes the open REV and opens another for the new one",
      "line": "closed"
    },
    {
      "id": "T14",
      "from": [
        "accepted"
      ],
      "to": "ratify",
      "op": [
        "stage.package"
      ],
      "actor": "agent",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "the reference is in `accepted` (gtt-stage.sh --origin)",
      "line": "package",
      "owner": "stage"
    },
    {
      "id": "T15",
      "from": [
        "ratify"
      ],
      "to": [
        "work",
        "closed"
      ],
      "op": [
        "inbox.reconcile"
      ],
      "actor": "gtt",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "the set was applied or the Epic is Planned",
      "line": "ratified",
      "owner": "reconcile"
    },
    {
      "id": "T16",
      "from": [
        "ratify",
        "work"
      ],
      "to": "accepted",
      "op": [
        "inbox.reconcile"
      ],
      "actor": "gtt",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "there is an undo record",
      "line": "undone",
      "owner": "reconcile"
    },
    {
      "id": "T17",
      "from": [
        "ratify"
      ],
      "to": "ratify",
      "op": [
        "stage.package"
      ],
      "actor": "agent",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "the draft or a destination changed",
      "line": "package",
      "owner": "stage"
    },
    {
      "id": "T18",
      "from": [
        "work"
      ],
      "to": "closed",
      "op": [
        "inbox.reconcile"
      ],
      "actor": "gtt",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "everything it produced is finished",
      "line": "closed",
      "owner": "reconcile"
    },
    {
      "id": "T19",
      "from": [
        "work"
      ],
      "to": "closed",
      "op": [
        "inbox.reconcile"
      ],
      "actor": "gtt",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "what it produced was cancelled",
      "line": "closed",
      "owner": "reconcile"
    },
    {
      "id": "T20",
      "from": [
        "parked"
      ],
      "to": [
        "new",
        "review"
      ],
      "op": [
        "inbox.reopen"
      ],
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "an idea returns to `new`; a proposal opens a new REV",
      "line": "reopened"
    },
    {
      "id": "T21",
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "an open REV is marked attended; a ready set is archived in proposals/withdrawn/",
      "alts": [
        {
          "from": [
            "new",
            "review",
            "accepted",
            "ratify"
          ],
          "to": "parked",
          "op": [
            "inbox.park"
          ],
          "line": "parked"
        },
        {
          "from": [
            "new",
            "review",
            "accepted",
            "ratify",
            "parked"
          ],
          "to": "rejected",
          "op": [
            "inbox.drop"
          ],
          "entry": [
            "IDEA"
          ],
          "line": "dropped"
        },
        {
          "from": [
            "new",
            "review",
            "accepted",
            "ratify",
            "parked"
          ],
          "to": "rejected",
          "op": [
            "inbox.reject"
          ],
          "entry": [
            "PROP"
          ],
          "line": "rejected"
        }
      ]
    },
    {
      "id": "T22",
      "from": [
        "accepted",
        "ratify",
        "work"
      ],
      "to": "same",
      "op": [
        "inbox.priority"
      ],
      "actor": "human",
      "entry": [
        "PROP",
        "IDEA"
      ],
      "guard": "in `work` only while its Epic or Story is not In Progress",
      "line": "priority"
    },
    {
      "id": "T23",
      "from": [
        "review"
      ],
      "to": "closed",
      "op": [
        "pending.answer"
      ],
      "variant": [
        "close"
      ],
      "actor": "human",
      "entry": [
        "PROP"
      ],
      "guard": "same as T10; only a closure proposal (`non-goal`)",
      "line": "decision"
    }
  ],
  "triage_results": {
    "work": {},
    "covered": {},
    "scope": {},
    "spec": {},
    "arch": {},
    "non-goal": {},
    "ask": {},
    "incorporated": {},
    "converted": {
      "legacy": true,
      "to": "[A-Za-z0-9._-]+"
    }
  },
  "triage_targets": {
    "work": "STORY-\\d+",
    "covered": "(?:EPIC|IDEA|PROP)-\\d+",
    "scope": "PROP-\\d+",
    "spec": "PROP-\\d+",
    "arch": "PROP-\\d+",
    "non-goal": "PROP-\\d+",
    "ask": "ASK-\\d+",
    "incorporated": "[A-Za-z0-9._/-]+",
    "converted": "[A-Za-z0-9._-]+"
  },
  "forms": {
    "1": {
      "title": "Proposed Architecture Change",
      "name": "Architecture change",
      "levels": [
        "arch"
      ],
      "fields": [
        "Current decision",
        "Suggested change",
        "Reason",
        "Impact",
        "Risk",
        "Affected files",
        "Alternatives considered"
      ]
    },
    "2": {
      "title": "Proposed Context Change",
      "name": "Context change",
      "levels": [
        "spec",
        "arch"
      ],
      "fields": [
        "File",
        "Current statement",
        "Suggested change",
        "Reason",
        "Impact",
        "Risk"
      ]
    },
    "3": {
      "title": "Context Conflict Detected",
      "name": "Context conflict",
      "levels": [
        "arch"
      ],
      "fields": [
        "Context file",
        "What the context says",
        "What the implementation does",
        "Where they diverge",
        "Possible resolutions"
      ]
    },
    "4": {
      "title": "Proposed Epic Change",
      "name": "Epic change",
      "levels": [
        "scope",
        "spec"
      ],
      "fields": [
        "Kind",
        "Epic ID",
        "Current state",
        "Goal",
        "Scope",
        "Out of Scope",
        "Reason",
        "Contradicts governed context or an ADR?",
        "Impact",
        "Risk"
      ]
    },
    "6": {
      "title": "Proposed Development Method Change",
      "name": "Method change",
      "levels": [
        "arch"
      ],
      "fields": [
        "Current method",
        "Proposed method",
        "Reason",
        "Incompatibilities",
        "Verification level",
        "Risk",
        "Alternatives considered"
      ]
    },
    "7": {
      "title": "Proposed Autonomy Profile Change",
      "name": "Autonomy Profile change",
      "levels": [
        "arch"
      ],
      "fields": [
        "Current plan",
        "Proposed plan",
        "Reason",
        "Controls that relax",
        "Risk",
        "Alternatives considered"
      ]
    },
    "closure": {
      "title": "Closure proposal",
      "name": "Closure",
      "levels": [
        "non-goal"
      ],
      "fields": [
        "Non-goal",
        "Reason"
      ]
    }
  },
  "refused_forms": {
    "5": "form 5 (a GTTGuard artifact) is approved in the conversation and never enters the inbox"
  },
  "state_keys": {
    "triage": "by value",
    "review": "review",
    "decision": "by value",
    "ready": "accepted",
    "package": "ratify",
    "ratified": "work",
    "work": "work",
    "undone": "accepted",
    "priority": "same",
    "reopened": "new",
    "closed": "closed",
    "parked": "parked",
    "dropped": "rejected",
    "rejected": "rejected"
  },
  "mirror_keys": [
    "decision",
