{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash .gtt/scripts/gtt-run-python.sh .gtt/scripts/gtt_protect.py hook --format cursor",
        "matcher": "Shell|Write|Delete",
        "timeout": 20
      }
    ],
    "sessionStart": [
      {
        "command": "bash .gtt/scripts/gtt-run-python.sh .gtt/scripts/gtt_session_hook.py cursor",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "bash .gtt/scripts/gtt-checkpoint.sh --quiet",
        "timeout": 30
      }
    ]
  }
}
