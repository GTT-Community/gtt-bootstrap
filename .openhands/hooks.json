{
  "pre_tool_use": [
    {
      "matcher": "*",
      "hooks": [
        { "command": "bash .gtt/scripts/gtt-run-python.sh .gtt/scripts/gtt_protect.py hook --format openhands", "timeout": 20 }
      ]
    }
  ],
  "session_start": [
    {
      "matcher": "*",
      "hooks": [
        { "command": "bash .gtt/scripts/gtt-run-python.sh .gtt/scripts/gtt_protect.py hook --format openhands", "timeout": 30 }
      ]
    }
  ]
}
