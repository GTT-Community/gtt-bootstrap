{
  "version": "v1",
  "hooks": [
    {
      "name": "gtt-activity-log",
      "trigger": "PostToolUse",
      "matcher": "[Ww]rite|[Ee]dit|[Cc]reate|[Rr]eplace|[Dd]elete|[Pp]atch|[Ss]hell|[Bb]ash|[Ee]xecute",
      "action": {
        "type": "command",
        "command": "bash .gtt/scripts/gtt-activity.sh log --ade kiro",
        "timeout": 20
      }
    }
  ]
}
