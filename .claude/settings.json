{
  "permissions": {
    "deny": [
      "Edit(/AGENTS.md)",
      "Write(/AGENTS.md)",
      "Edit(/gtt/CHANGE-REQUEST.md)",
      "Write(/gtt/CHANGE-REQUEST.md)",
      "Edit(/SOURCE-BRIEF.*)",
      "Write(/SOURCE-BRIEF.*)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c '' >/dev/null 2>&1 && python3 .claude/hooks/protect-l0.py || python .claude/hooks/protect-l0.py"
          },
          {
            "type": "command",
            "command": "python3 -c '' >/dev/null 2>&1 && python3 .claude/hooks/protect-guard.py || python .claude/hooks/protect-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/detect-drift.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/notify-change-request.py"
          }
        ]
      }
    ]
  }
}
