{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/AGENTS.md)",
      "Write(/AGENTS.md)",
      "Edit(/SOURCE-BRIEF.*)",
      "Write(/SOURCE-BRIEF.*)",
      "Edit(/gtt-domain/.frozen)",
      "Write(/gtt-domain/.frozen)",
      "Edit(/gtt-domain/governance-backlog.json)",
      "Write(/gtt-domain/governance-backlog.json)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "Edit(/.gtt/local/checkpoint.json)",
      "Write(/.gtt/local/checkpoint.json)",
      "Edit(/.gtt/local/last-validation.json)",
      "Write(/.gtt/local/last-validation.json)",
      "Edit(/docs/sources/**)",
      "Write(/docs/sources/**)",
      "Edit(/docs/ideas/**)",
      "Write(/docs/ideas/**)",
      "Edit(/gtt-domain/adr/drafts/**)",
      "Write(/gtt-domain/adr/drafts/**)",
      "Edit(/gtt-domain/proposals/PROP-*.md)",
      "Write(/gtt-domain/proposals/PROP-*.md)",
      "Edit(/gtt-domain/proposals/done/**)",
      "Write(/gtt-domain/proposals/done/**)",
      "Edit(/gtt-domain/proposals/withdrawn/PROP-*.md)",
      "Write(/gtt-domain/proposals/withdrawn/PROP-*.md)",
      "Edit(/gtt-domain/pending/**)",
      "Write(/gtt-domain/pending/**)",
      "Edit(/.gtt/local/prompts.jsonl)",
      "Write(/.gtt/local/prompts.jsonl)",
      "Edit(/.gtt/local/pending-state.json)",
      "Write(/.gtt/local/pending-state.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-l0.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-l0.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/detect-drift.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/delivery-log.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/sonar-render.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py post"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py post"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/pending-watch.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/session-start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-checkpoint.sh --quiet"
          }
        ]
      }
    ]
  }
}
