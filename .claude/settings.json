{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/AGENTS.md)",
      "Write(/AGENTS.md)",
      "Edit(/SOURCE-BRIEF.*)",
      "Write(/SOURCE-BRIEF.*)",
      "Edit(/gtt-domain/.frozen)",
      "Write(/gtt-domain/.frozen)",
      "Edit(/gtt-domain/governance-backlog.json)",
      "Write(/gtt-domain/governance-backlog.json)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "Edit(/.gtt/local/checkpoint.json)",
      "Write(/.gtt/local/checkpoint.json)",
      "Edit(/.gtt/local/last-validation.json)",
      "Write(/.gtt/local/last-validation.json)",
      "Edit(/docs/sources/**)",
      "Write(/docs/sources/**)",
      "Edit(/docs/ideas/**)",
      "Write(/docs/ideas/**)",
      "Edit(/gtt-domain/adr/drafts/**)",
      "Write(/gtt-domain/adr/drafts/**)",
      "Edit(/gtt-domain/proposals/PROP-*.md)",
      "Write(/gtt-domain/proposals/PROP-*.md)",
      "Edit(/gtt-domain/proposals/done/**)",
      "Write(/gtt-domain/proposals/done/**)",
      "Edit(/gtt-domain/proposals/withdrawn/PROP-*.md)",
      "Write(/gtt-domain/proposals/withdrawn/PROP-*.md)",
      "Edit(/gtt-domain/pending/**)",
      "Write(/gtt-domain/pending/**)",
      "Edit(/.gtt/local/prompts.jsonl)",
      "Write(/.gtt/local/prompts.jsonl)",
      "Edit(/.gtt/local/pending-state.json)",
      "Write(/.gtt/local/pending-state.json)",
      "Edit(/.gtt/local/activity.jsonl)",
      "Write(/.gtt/local/activity.jsonl)",
      "Edit(/.gtt/local/activity-state.json)",
      "Write(/.gtt/local/activity-state.json)",
      "Read(~/.gtt/sonar/**)",
      "Read(//home/**/.gtt/sonar/**)",
      "Edit(/PREGUNTAS.md)",
      "Write(/PREGUNTAS.md)",
      "Edit(/docs/PREGUNTAS.md)",
      "Write(/docs/PREGUNTAS.md)",
      "Edit(/QUESTIONS.md)",
      "Write(/QUESTIONS.md)",
      "Edit(/docs/QUESTIONS.md)",
      "Write(/docs/QUESTIONS.md)",
      "Edit(/TABLERO.md)",
      "Write(/TABLERO.md)",
      "Edit(/docs/TABLERO.md)",
      "Write(/docs/TABLERO.md)",
      "Edit(/BOARD.md)",
      "Write(/BOARD.md)",
      "Edit(/docs/BOARD.md)",
      "Write(/docs/BOARD.md)",
      "Edit(/KANBAN.md)",
      "Write(/KANBAN.md)",
      "Edit(/docs/KANBAN.md)",
      "Write(/docs/KANBAN.md)",
      "Edit(/decisiones.md)",
      "Write(/decisiones.md)",
      "Edit(/docs/decisiones.md)",
      "Write(/docs/decisiones.md)",
      "Edit(/DECISIONS.md)",
      "Write(/DECISIONS.md)",
      "Edit(/docs/DECISIONS.md)",
      "Write(/docs/DECISIONS.md)",
      "Edit(/TODO.md)",
      "Write(/TODO.md)",
      "Edit(/docs/TODO.md)",
      "Write(/docs/TODO.md)",
      "Edit(/TASKS.md)",
      "Write(/TASKS.md)",
      "Edit(/docs/TASKS.md)",
      "Write(/docs/TASKS.md)",
      "Edit(/STATUS.md)",
      "Write(/STATUS.md)",
      "Edit(/docs/STATUS.md)",
      "Write(/docs/STATUS.md)",
      "Edit(/ESTADO.md)",
      "Write(/ESTADO.md)",
      "Edit(/docs/ESTADO.md)",
      "Write(/docs/ESTADO.md)",
      "Edit(/BACKLOG.md)",
      "Write(/BACKLOG.md)",
      "Edit(/docs/BACKLOG.md)",
      "Write(/docs/BACKLOG.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-l0.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-l0.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/protect-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/detect-drift.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/delivery-log.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/activity-log.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/sonar-render.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py post"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/governed-sentinel.py post"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/pending-watch.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-run-python.sh .claude/hooks/session-start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash .gtt/scripts/gtt-checkpoint.sh --quiet"
          }
        ]
      }
    ]
  }
}
